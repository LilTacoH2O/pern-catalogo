# Copia este archivo como .env y pon tus valores reales (NO subas .env a GitHub)
PORT=3000
# Cadena de conexión de Neon: Dashboard > Connect > Connection string
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Origen del frontend que puede leer las respuestas de la API (CORS)
CLIENT_URL=http://localhost:5173
# Secreto de firma JWT (usa una cadena aleatoria de al menos 30 caracteres)
JWT_SECRET=REEMPLAZA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=2h
# Contraseñas para los usuarios de práctica (mínimo 8 caracteres)
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_SEGURA
EDITOR_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_SEGURA